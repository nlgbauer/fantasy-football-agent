# Copy to .env; generate two different random secrets of at least 32 characters.
ADMIN_TOKEN=
INGRESS_TOKEN=
PORT=8787
LIVE_SEND=false
WHATSAPP_ENABLED=false
MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
WHATSAPP_GROUP_ID=
# the owner's verified private chat ID (not the league group).
NATE_WHATSAPP_ID=
GMAIL_FROM=
GMAIL_TO=
GMAIL_REVIEW_TO=
# smtp uses a Google app password; oauth uses the three GOOGLE_* fields below.
GMAIL_TRANSPORT=smtp
GMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_S2=
SWID=
# Optional when the authenticated ESPN account owns exactly one team.
ESPN_TEAM_ID=
# Enables only starter/bench LINEUP transactions created internally by ChatPDT.
ESPN_LINEUP_WRITE_ENABLED=false
ESPN_LINEUP_MIN_GAIN=1
LINEUP_EMAIL_NOTIFICATIONS=true
WEEKLY_AUTO_DRAFT=false
WEEKLY_STORY_COUNT=4

